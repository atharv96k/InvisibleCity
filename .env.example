# Copy this file to .env and fill in your own key. Never commit .env.
GROQ_API_KEY=your_groq_key_here
# Models are tried in order. Use any open-weight model your Groq account lists.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional
# GROQ_TIMEOUT_MS=7000
# RATE_LIMIT_PER_MIN=10

# Google Maps Places API (New) key for finding historical places and attractions within 4 km.
# Without it the app falls back to Wikipedia, which finds far fewer places.
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Gemini API key (free from aistudio.google.com/apikey). Gemini suggests historical places near the
# area; each one is checked against OpenStreetMap before it is shown.
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
